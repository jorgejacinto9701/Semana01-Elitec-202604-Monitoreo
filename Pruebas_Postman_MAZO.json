{
  "info": {
    "_postman_id": "7f3a9c1e-5b2d-4f0a-9c8e-6d4b1a2e3f40",
    "name": "EV3_MAZO_Producto_Categoria",
    "description": "Evaluación T3 - MAZO TABARES - Consultas JPQL Producto/Categoría con @PathVariable y @RequestParam",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "53506462"
  },
  "item": [
    {
      "name": "Login JWT - Obtener token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.token) {",
              "  pm.collectionVariables.set('token', json.token);",
              "}",
              "pm.test('Login exitoso devuelve token', function () {",
              "  pm.expect(json.token).to.not.be.undefined;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"login\": \"{{usuario}}\",\r\n    \"password\": \"{{password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/url/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "url",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET PathVariable - productos por categoria y precio",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/url/producto/porCategoriaYPrecio/2/20.0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "url",
            "producto",
            "porCategoriaYPrecio",
            "2",
            "20.0"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET RequestParam - productos por descripcion de categoria y stock",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/url/producto/consulta?descripcion=Condimentos&stock=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "url",
            "producto",
            "consulta"
          ],
          "query": [
            {
              "key": "descripcion",
              "value": "Condimentos"
            },
            {
              "key": "stock",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090",
      "type": "string"
    },
    {
      "key": "usuario",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "secret": true
    }
  ]
}